# Copy to .env and fill in real values. The server loads .env from the app root
# (see server/plugins/load-env.ts), so every variable below must be present in production.

# Prisma / MySQL connection. The database and user are created manually by the
# human operator — do not reuse the dev credentials from any other environment.
DATABASE_URL="mysql://organicaprico_user:<password>@localhost:3306/organicaprico"

# WhatsApp number shown in contact/UI copy (not currently read by any server code).
WHATSAPP_NUMBER="923311116915"

# Password for the /admin login.
ADMIN_PASSWORD="change-me"

# Long random string used to sign admin session cookies (HMAC).
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Must be "production" on the server: makes the admin session cookie Secure.
NODE_ENV=production
